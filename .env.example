DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/user_role_db"
SESSION_SECRET="string-acak-minimal-32-karakter"
SEED_ADMIN_EMAIL="admin@example.com"
# Ganti dengan password unik minimal 12 karakter sebelum menjalankan seed.
SEED_ADMIN_PASSWORD="CHANGE_ME_MIN_12_KARAKTER"

# Seed bersifat destruktif (menghapus semua data). Di production, set ini ke
# "true" hanya jika benar-benar ingin mereset database.
# ALLOW_DESTRUCTIVE_SEED="true"

# Set "true" hanya jika aplikasi berada di belakang reverse proxy yang
# menimpa x-forwarded-for / x-real-ip. Jangan aktifkan jika akses langsung.
# TRUST_PROXY="true"

# Opsional. Kunci enkripsi secret TOTP; jika kosong, diturunkan dari
# SESSION_SECRET. Minimal 32 karakter. Jangan ganti setelah MFA dipakai.
# MFA_ENCRYPTION_KEY=""

# Opsional. Wajibkan Super Admin mengaktifkan MFA sebelum mengakses modul lain.
# Jika "true", Super Admin yang belum enroll MFA akan diblokir & dialihkan ke /dashboard/security.
# ENFORCE_SUPER_ADMIN_MFA="true"

# Optional: absolute path to Chrome/Edge used by `npm run smoke`.
# CHROME_PATH="C:\Program Files\Google\Chrome\Application\chrome.exe"
